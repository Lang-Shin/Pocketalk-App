{
  "expo": {
    "name": "Pocketa",
    "slug": "pocketa",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/branding/pocketa-launcher.png",
    "scheme": "pocketa",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.pocketa.app",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#252427",
        "foregroundImage": "./assets/branding/pocketa-adaptive-foreground.png",
        "monochromeImage": "./assets/branding/pocketa-adaptive-monochrome.png"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
